{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "component": "laddu",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.startsWith(\"laddu\"))].version"
        },
        {
          "type": "generic",
          "path": "python/laddu/pyproject.toml"
        },
        {
          "type": "generic",
          "path": "CITATION.cff"
        }
      ]
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ]
}
